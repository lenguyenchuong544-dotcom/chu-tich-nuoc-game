{
  "name": "president-game-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:export": "node -e \"process.env.EXPORT='true'; process.env.NEXT_PUBLIC_BASE_PATH='/chu-tich-nuoc-game'; require('child_process').execSync('npx next build', {stdio:'inherit', env: process.env})\"",
    "start": "node -e \"if (!require('fs').existsSync('.next')) { require('child_process').execSync('next build', {stdio:'inherit'}) }\" && next start -p 3000",
    "start:prod": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/eslintrc": "^2.1.4",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.446.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4"
  }
}
